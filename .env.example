# ==================== CRITICAL SECRETS ====================
# IP of the machine running ai-stack.sh, as seen from the robot
SERVER_IP=127.0.0.1
# Any model your LLM server loads - your choice.
# NOTE: the app reads LLAMA_MODEL, not OLLAMA_MODEL.
LLAMA_MODEL=
WEBUI_API_KEY=change-me
REMOTE_PI_DOG_PASSWORD=change-me
PIDOG_SSH_PASSWORD=change-me

# ==================== AI STACK SECRETS ====================
# Optional: web search API key (leave blank to disable)
TAVILY_API_KEY=
# Optional: Cloudflare tunnel tokens (leave blank to skip tunnels)
CF_TUNNEL_TOKEN_OLLAMA=
CF_TUNNEL_TOKEN_WEBUI=

# ==================== TTS & TIMING ====================
TTS_VOICE=af_heart
TTS_MODEL=kokoro
# LLM request timeout in seconds
LLAMA_TIMEOUT=30
